# ==========================================
# 网课助手 - 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ==========================================

# ---------- 网课平台账号 ----------
# 网课平台登录用户名
COURSE_USERNAME=your_username_here
# 网课平台登录密码
COURSE_PASSWORD=your_password_here

# ---------- AI 大模型配置 ----------
# AI 模型的 API Key
AI_API_KEY=sk-your-api-key-here
# AI 模型的 API 地址 (例如 OpenAI / 本地部署的模型)
AI_API_URL=https://api.openai.com/v1/chat/completions
# AI 模型名称 (可选，如 gpt-4, gpt-3.5-turbo, deepseek-chat 等)
AI_MODEL=gpt-4

# ---------- 智慧树课程 ----------
# 智慧树课程播放页完整 URL（可选，不填则启动后终端提示输入）
COURSE_URL=https://studyh5.zhihuishu.com/xxx
